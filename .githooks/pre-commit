#!/bin/sh
# Pre-commit hook: runs fmt check, clippy, and tests when committing to master
#
# Install with: git config core.hooksPath .githooks

set -e

BRANCH=$(git rev-parse --abbrev-ref HEAD)

# Only run full checks when committing to master
if [ "$BRANCH" = "master" ] || [ "$BRANCH" = "main" ]; then
    echo "Committing to $BRANCH - running quality checks..."

    echo "==> Checking formatting..."
    cargo fmt --all -- --check
    if [ $? -ne 0 ]; then
        echo "ERROR: Formatting check failed. Run 'cargo fmt --all' to fix."
        exit 1
    fi

    echo "==> Running clippy..."
    RUSTFLAGS="-Dwarnings" cargo clippy --all-features --all-targets -- -D warnings
    if [ $? -ne 0 ]; then
        echo "ERROR: Clippy found issues."
        exit 1
    fi

    echo "==> Running tests..."
    cargo test --all
    if [ $? -ne 0 ]; then
        echo "ERROR: Tests failed."
        exit 1
    fi

    echo "All checks passed!"
fi
